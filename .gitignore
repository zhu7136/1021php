# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
build/
dist/

# Training artifacts
logs/
wandb/
outputs/
*.pt
*.onnx

# Motion / terrain data — pulled from a registry, not versioned
motions/
*.npz
*.npy
*.obj

# Editors / tooling
.vscode/
.idea/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Motion matching ships a small source motion and G1 robot geometry. Keep
# these intentional assets even though generated motion/mesh files are ignored.
!motion_matching/assets/robot_motions/
!motion_matching/assets/robot_motions/*.npz
!motion_matching/assets/robots/
!motion_matching/assets/robots/**

# User-specific optional service configuration
.env.local
GMR/
humanoid-description/
limx_rl_lab/
holosoma-main/
thirdparty/holosoma/
node_modules/
__pycache__/
*.pyc

# Isolated LimX Flux runtime (never commit dependencies or runtime copies).
.flux-deps/
.flux-runtime/
.aria-deps/

# Explicitly version the recovered HU_D04 training inputs on the Flux branch.
!flux/data/motions-low-step-hu-d04/*.npz
!flux/data/motions-low-step-hu-d04/*.npy
!flux/holosoma_overlay/data/robots/hu_d04/**/*.obj

